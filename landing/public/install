#!/bin/sh
set -eu

RELEASES="https://github.com/gnmyt/tunlit/releases/latest/download"
APT_KEY="https://packages.buildkite.com/tunlit/apt/gpgkey"
APT_REPO="https://packages.buildkite.com/tunlit/apt/any/ any main"
RPM_REPO="https://packages.buildkite.com/tunlit/rpm/rpm_any/rpm_any"

say() { printf '  %s\n' "$*"; }
fail() { printf 'tunlit: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

os=$(uname -s)
arch=$(uname -m)

case "$arch" in
    x86_64|amd64) arch=x64 ;;
    aarch64|arm64) arch=arm64 ;;
    armv7*) arch=armv7 ;;
    riscv64) arch=riscv64 ;;
    *) fail "unsupported architecture: $arch. tunlit ships for x86-64, ARM64, ARMv7 and RISC-V." ;;
esac

case "$os" in
    Linux) os=linux ;;
    Darwin) os=macos ;;
    *) fail "unsupported operating system: $os. On Windows run: irm https://tunlit.dev/install.ps1 | iex" ;;
esac

if [ "$(id -u)" -eq 0 ]; then SUDO=""; elif have sudo; then SUDO="sudo"; else SUDO=""; fi

fetch() {
    if have curl; then curl -fsSL "$1" -o "$2"
    elif have wget; then wget -qO "$2" "$1"
    else fail "curl or wget is required"
    fi
}

ensure_fetcher() {
    have curl || have wget && return 0
    [ -n "$SUDO" ] || [ "$(id -u)" -eq 0 ] || fail "curl or wget is required"
    say "Installing curl"
    if have apt-get; then export DEBIAN_FRONTEND=noninteractive; $SUDO apt-get update -qq && $SUDO apt-get install -y -qq ca-certificates curl
    elif have dnf; then $SUDO dnf install -y -q curl
    elif have yum; then $SUDO yum install -y -q curl
    elif have apk; then $SUDO apk add --no-cache curl ca-certificates
    else fail "curl or wget is required"
    fi
}

install_apt() {
    have apt-get || return 1
    [ -n "$SUDO" ] || [ "$(id -u)" -eq 0 ] || return 1
    say "Adding the apt repository"
    ensure_fetcher
    if ! have gpg; then
        export DEBIAN_FRONTEND=noninteractive
        $SUDO apt-get update -qq || return 1
        $SUDO apt-get install -y -qq gnupg || return 1
    fi
    fetch "$APT_KEY" /tmp/tunlit-apt.key || return 1
    $SUDO mkdir -p /usr/share/keyrings || return 1
    $SUDO gpg --dearmor --yes -o /usr/share/keyrings/tunlit.gpg /tmp/tunlit-apt.key || return 1
    rm -f /tmp/tunlit-apt.key
    echo "deb [signed-by=/usr/share/keyrings/tunlit.gpg] $APT_REPO" | $SUDO tee /etc/apt/sources.list.d/tunlit.list >/dev/null || return 1
    $SUDO apt-get update -qq || return 1
    $SUDO apt-get install -y -qq tunlit-cli
}

install_rpm() {
    if have dnf; then manager=dnf; elif have yum; then manager=yum; else return 1; fi
    [ -n "$SUDO" ] || [ "$(id -u)" -eq 0 ] || return 1
    say "Adding the rpm repository"
    $SUDO tee /etc/yum.repos.d/tunlit.repo >/dev/null <<EOF || return 1
[tunlit]
name=tunlit
baseurl=$RPM_REPO/\$basearch
gpgkey=https://packages.buildkite.com/tunlit/rpm/gpgkey
repo_gpgcheck=1
gpgcheck=0
enabled=1
EOF
    $SUDO $manager install -y -q tunlit-cli
}

static_build() {
    [ "$os" = linux ] || return 1
    case "$arch" in armv7|riscv64) return 0 ;; esac
    glibc=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
    [ -n "$glibc" ] || return 0
    [ "$(printf '%s\n' 2.35 "$glibc" | sort -V | head -1)" = 2.35 ] && return 1
    return 0
}

install_binary() {
    ensure_fetcher
    asset="tunlit-$os-$arch"
    if static_build; then asset="$asset-static"; fi
    say "Downloading $asset"
    tmp=$(mktemp)
    fetch "$RELEASES/$asset" "$tmp"
    chmod +x "$tmp"
    if [ -w /usr/local/bin ] || [ -n "$SUDO" ]; then
        $SUDO install -m 755 "$tmp" /usr/local/bin/tunlit
        target=/usr/local/bin/tunlit
    else
        mkdir -p "$HOME/.local/bin"
        install -m 755 "$tmp" "$HOME/.local/bin/tunlit"
        target="$HOME/.local/bin/tunlit"
        case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) say "Add $HOME/.local/bin to your PATH" ;; esac
    fi
    rm -f "$tmp"
    say "Installed $target"
}

printf '\n  tunlit installer (%s %s)\n\n' "$os" "$arch"

if [ "$os" = linux ] && ! static_build; then
    if install_apt; then :
    elif install_rpm; then :
    else install_binary
    fi
else
    install_binary
fi

printf '\n'
if have tunlit; then say "$(tunlit --version)"; else say "Installed. Open a new terminal to use tunlit."; fi
say "Next: tunlit login"
printf '\n'
