[Unit]
Description=tunlit server
Documentation=https://docs.tunlit.dev/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tunlit
Group=tunlit
WorkingDirectory=/var/lib/tunlit-server
EnvironmentFile=-/etc/tunlit-server/server.env
Environment=NODE_ENV=production
Environment=TUNLIT_DATA_DIR=/var/lib/tunlit-server
Environment=TUNLIT_CONFIG=/etc/tunlit-server/config.yml
ExecStart=/usr/bin/tunlit-server
Restart=on-failure
RestartSec=5

AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/tunlit-server

[Install]
WantedBy=multi-user.target
