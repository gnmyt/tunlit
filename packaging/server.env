# Settings for the tunlit server. Everything here is optional: the guided setup
# in the browser writes what it needs into the database.
#
# TUNLIT_BASE_DOMAIN=tunlit.example.com
# TUNLIT_PUBLIC_URL=https://tunlit.example.com
#
# "proxy" if nginx or Caddy terminates TLS in front of tunlit, "acme" to let
# tunlit hold its own certificate and serve 443 itself.
# TUNLIT_TLS_MODE=proxy
# TUNLIT_TRUST_PROXY=true
#
# TUNLIT_PORT=8080
# LOG_LEVEL=info
